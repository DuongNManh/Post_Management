# Production Environment Variables
# Copy this file to .env and update values

# GitHub Container Registry
GITHUB_REPOSITORY=your-username/learning-web-2

# Domain Configuration
DOMAIN_NAME=your-domain.com

# Database Configuration
DB_NAME=PostManagementDB
DB_USER=db_user
DB_PASSWORD=your-secure-password-here
DB_CONNECTION_STRING=Host=post_management.db;Database=PostManagementDB;Username=db_user;Password=your-secure-password-here;Port=5432

# Security
JWT_SECRET=your-jwt-secret-key-here-minimum-32-characters

# Optional: Monitoring
ENABLE_MONITORING=true

# Optional: Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM