# Environment variables for production deployment
# Copy this to .env and update values for your environment

# GitHub Container Registry
GITHUB_REPOSITORY_OWNER=your-username

# External PostgreSQL Database Configuration
# Replace with your actual PostgreSQL server details
DB_CONNECTION_STRING=Host=your-postgres-server-ip;Database=PostManagementDB;Username=your-db-user;Password=your-db-password;Port=5432

# JWT Configuration (Generate strong secrets!)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_ISSUER=PostManagementAPI
JWT_AUDIENCE=PostManagementUI

# API Configuration
EXTERNAL_API_HOST=your-domain.com

# Database Migration & Seeding
APPLY_MIGRATIONS=true
SEED_DATABASE=true

# Optional: Cloudflare settings (if using)
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Database Server Examples:
# For local PostgreSQL on host: Host=host.docker.internal;Database=PostManagementDB;Username=postgres;Password=yourpassword;Port=5432
# For separate PostgreSQL server: Host=192.168.1.100;Database=PostManagementDB;Username=postmgmt_user;Password=yourpassword;Port=5432
# For managed PostgreSQL: Host=your-postgres.amazonaws.com;Database=PostManagementDB;Username=admin;Password=yourpassword;Port=5432;SslMode=Require